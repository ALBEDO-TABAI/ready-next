  "whitelist": [
    {
      "glob": "src/renderer/design/next/**",
      "reason": "W1 §3.1 的共享设计令牌来源。"
    },
    {
      "glob": "src/renderer/modules/library/reader/marks.ts",
      "reason": "MARKERS / markerColor 定义用户阅读划线颜色。"
    },
    {
      "glob": "src/renderer/modules/library/topics.ts",
      "reason": "lookOf 生成书脊布色与配套前景色；布色色板本体在扫描范围外的 src/shared/library-topics.ts。"
    },
    {
      "glob": "src/renderer/modules/library/reader/papers.ts",
      "reason": "PAPERS 是读者在排版里选的阅读纸色（白纸、米黄、夜间）：书页的纸、页边与墨，印进书页栅格，属于内容数据。"
    },
    {
      "glob": "src/renderer/modules/document/content-palette.css",
      "reason": "写作者给自己内容选的颜色：文字颜色与背景、标注块（> [!tip|yellow]）颜色、数据库选项标签色，属于用户内容颜色。"
    }
  ],
  "goals": {
    "color": "模块样式颜色字面量为 0",
    "backdropFilter": "只在材质文件",
    "fontFace": "只在 src/renderer/design/next/tokens.css",
