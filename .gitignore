# Dependencies
node_modules/
# worktree 布局下 node_modules 是指向主仓的符号链接，尾斜杠模式匹配不到
node_modules
.pnp
.pnp.js

# Build outputs
out/
dist/
*.tsbuildinfo

# Python caches
__pycache__/
*.py[cod]

# Environment files
.env
.env.local
.env.*.local

# IDE
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo

# OS
**/.DS_Store
Thumbs.db

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
