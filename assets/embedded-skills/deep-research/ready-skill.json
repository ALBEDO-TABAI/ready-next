{
  "id": "deep-research",
  "name": "deep-research",
  "displayName": "Deep Research",
  "description": "系统化多源研究方法论：维度拆解 + 多查询 + 全文 fetch + 引用追踪",
  "version": "0.1.0",
  "runtime": "reference",
  "execution": { "mode": "advisory" },
  "configuration": {
    "version": 1,
    "serviceBindings": [
      {
        "id": "searchService",
        "label": "优先搜索服务",
        "description": "可选 AnySearch、Tavily 或 DuckDuckGo；AnySearch 额外支持垂直领域。",
        "allowedKinds": ["anysearch", "tavily", "duckduckgo"],
        "defaultServiceId": "tavily-default",
        "required": false
      },
      {
        "id": "fetchService",
        "label": "全文抓取服务",
        "description": "可选 Jina Reader、AnySearch Extract 或 Tavily Extract。",
        "allowedKinds": ["anysearch", "jina", "tavily"],
        "defaultServiceId": "jina-default",
        "required": false
      }
    ],
    "fields": []
  },
  "actions": {
    "read_skill": {
      "runtime": "reference",
      "visibility": "internal"
    }
  }
}
