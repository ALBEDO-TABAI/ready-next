{
  "id": "video-expert-analyzer",
  "name": "Video Expert Analyzer (VNext)",
  "description": "长视频深度分析 — staged 可续跑、19 类视频路由、并行批次评分、OpenClaw 接力。",
  "version": "2026.04.23-vnext",
  "defaultAction": "read_skill",
  "requirementsFile": "requirements.txt",
  "execution": {
    "mode": "advisory"
  },
  "actions": [
    {
      "name": "read_skill",
      "description": "读取并应用该技能的说明与方法完成当前任务。",
      "runtime": "reference",
      "entry": "SKILL.md",
      "visibility": "internal",
      "params": []
    },
    {
      "name": "video_expert_pipeline",
      "description": "执行视频深度分析 pipeline（prepare→score→finalize 一体化）。30 分钟超时，运行期写 run_state.json。供产品代码（item-analysis-manager）直接调用；当 reference-skill hint 为 video-expert-analyzer 时也对 LLM 暴露（参见 host_requirements.expose_when_hint_armed）——LLM 应优先用本 typed action 跑长链路，而不是用 skill_run_shell 直接 fork python（后者只 10 分钟）。",
      "runtime": "python",
      "entry": "scripts/ready_compat.py",
      "visibility": "internal",
      "inputMode": "json",
      "baseArgs": ["--action", "video_expert_pipeline"],
      "params": [
        { "name": "url", "type": "string", "description": "视频 URL", "required": true },
        { "name": "outputDir", "type": "string", "description": "输出目录", "required": false },
        { "name": "sceneThreshold", "type": "number", "description": "分镜阈值", "required": false },
        { "name": "bestThreshold", "type": "number", "description": "精选阈值", "required": false }
      ]
    },
    {
      "name": "video_expert_ai_analyze",
      "description": "对 scene_scores.json 跑 AI 视觉评分（score_batches / merge_validate 阶段）。30 分钟超时；运行期靠 run_state.json 状态追踪。供产品代码直接调用；当 reference-skill hint 为 video-expert-analyzer 时也对 LLM 暴露 —— LLM 应优先用本 typed action，而不是用 skill_run_shell 跑 ai_analyzer.py（后者只 10 分钟）。",
      "runtime": "python",
      "entry": "scripts/ready_compat.py",
      "visibility": "internal",
      "inputMode": "json",
      "baseArgs": ["--action", "video_expert_ai_analyze"],
      "params": [
        { "name": "sceneScoresPath", "type": "string", "description": "scene_scores.json 路径", "required": true },
        { "name": "outputDir", "type": "string", "description": "续跑输出目录；必须与 sceneScoresPath 属于同一任务", "required": false },
        { "name": "mode", "type": "string", "description": "评分模式（兼容字段，vnext 自动选择）", "required": false }
      ]
    }
  ],
  "host_requirements": {
    "spawn_context": {
      "config_file": {
        "path": "~/.config/video-expert-analyzer-vnext/config.json",
        "format": "json",
        "preserve_existing": true,
        "fields": {
          "/auto_scoring/preferred_model": "${agent.provider}/${agent.model_id}",
          "/auto_scoring/fallback_models": "${agent.fallback_chain}",
          "/auto_scoring/models_json_path": "${spawn.tmp_dir}/vea-models-${spawn.job_id}.json"
        }
      },
      "secondary_files": [
        {
          "path": "${spawn.tmp_dir}/vea-models-${spawn.job_id}.json",
          "content_template": "{\"providers\":{\"${agent.provider}\":{\"baseUrl\":\"${agent.base_url}\",\"apiKey\":\"${agent.api_key}\",\"api\":\"${agent.api_kind}\",\"authHeader\":true,\"models\":[{\"id\":\"${agent.model_id}\",\"name\":\"${agent.model_id}\",\"api\":\"${agent.api_kind}\",\"reasoning\":true,\"input\":${agent.input_modes},\"contextWindow\":256000,\"maxTokens\":32000}]}}}"
        }
      ]
    },
    "shell_allowlist_extensions": ["wc"],
    "default_action_timeout_ms": 3600000,
    "config_repair": {
      "files": [
        {
          "id": "config",
          "path": "~/.config/video-expert-analyzer-vnext/config.json",
          "format": "json"
        },
        {
          "id": "models",
          "path": "~/.config/video-expert-analyzer-vnext/models.multi.json",
          "format": "json"
        }
      ]
    },
    "status_detection": {
      "method": "sentinel_file",
      "file_path": "${output_dir}/run_state.json",
      "json_field": "status",
      "blocked_values": ["blocked", "pending_review", "awaiting_input"]
    },
    "lifecycle": {
      "on_uninstall_remove": ["~/.config/video-expert-analyzer-vnext"]
    },
    "expose_when_hint_armed": ["video_expert_pipeline", "video_expert_ai_analyze"]
  },
  "child_loop": {
    "version": 1,
    "actions": ["video_expert_pipeline", "video_expert_ai_analyze"]
  }
}
