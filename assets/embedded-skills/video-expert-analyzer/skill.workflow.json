{
  "version": "1",
  "autoAdvance": true,
  "initialStep": "download",
  "finalStep": "complete",
  "inputs": [
    { "key": "url", "description": "视频 URL", "type": "string", "required": true },
    { "key": "outputDir", "description": "输出目录", "type": "string", "required": false },
    { "key": "sceneThreshold", "description": "分镜阈值", "type": "number", "required": false },
    { "key": "bestThreshold", "description": "精选阈值", "type": "number", "required": false }
  ],
  "steps": [
    {
      "id": "download",
      "name": "Download And Score",
      "description": "执行 pipeline 并生成 scene_scores.json。",
      "requiredInputs": ["url"],
      "action": {
        "type": "runtime_call",
        "actionName": "video_expert_pipeline_runtime",
        "args": {
          "url": { "source": "input", "key": "url" },
          "outputDir": { "source": "input", "key": "outputDir" },
          "sceneThreshold": { "source": "input", "key": "sceneThreshold" },
          "bestThreshold": { "source": "input", "key": "bestThreshold" }
        }
      },
      "successCriteria": [
        { "type": "output_present", "outputKey": "sceneScoresPath" }
      ],
      "nextSteps": [{ "condition": "success", "targetStepId": "analyze" }]
    },
    {
      "id": "analyze",
      "name": "Summarize Visual Signals",
      "description": "让 Claude 基于 pipeline 产物生成视觉评审总结。",
      "action": {
        "type": "agent_task",
        "prompt": "请基于现有 scene_scores.json、markdown 报告和相关文本，输出一份视觉分析总结，至少覆盖高价值镜头、风险镜头、节奏建议和可保留片段。",
        "outputKey": "analysisSummaryText",
        "generatedFiles": [
          {
            "outputKey": "analysisSummaryPath",
            "pathTemplate": "{{executionOutputDir}}/visual_analysis_summary.md",
            "description": "视觉分析总结",
            "mimeType": "text/markdown"
          }
        ]
      },
      "nextSteps": [{ "condition": "success", "targetStepId": "review_confirm" }]
    },
    {
      "id": "review_confirm",
      "name": "Review Confirm",
      "description": "确认是否接受当前分析并继续产出最终结论。",
      "action": {
        "type": "confirmation",
        "message": "请确认是否接受当前视觉分析总结，并继续生成最终结论。",
        "confirmLabel": "继续完成",
        "denyLabel": "停止"
      },
      "nextSteps": [{ "condition": "success", "targetStepId": "complete" }]
    },
    {
      "id": "complete",
      "name": "Complete",
      "description": "让 Claude 产出最终可交付的视觉结论。",
      "action": {
        "type": "agent_task",
        "prompt": "请基于已有分析总结，再输出一份最终交付版视觉结论，格式要适合直接发给内容或剪辑同事。",
        "outputKey": "finalReviewText",
        "generatedFiles": [
          {
            "outputKey": "finalReviewPath",
            "pathTemplate": "{{executionOutputDir}}/visual_review_final.md",
            "description": "最终视觉结论",
            "mimeType": "text/markdown"
          }
        ]
      }
    }
  ]
}
