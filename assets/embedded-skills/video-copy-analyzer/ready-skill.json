{
  "id": "video-copy-analyzer",
  "name": "Video Copy Analyzer",
  "description": "Extract subtitles and generate transcript-oriented copy deliverables from a short video.",
  "version": "2026.04.25",
  "defaultAction": "read_skill",
  "requirementsFile": "requirements.txt",
  "execution": {
    "mode": "advisory"
  },
  "configuration": {
    "version": 1,
    "serviceBindings": [
      {
        "id": "bilibili",
        "label": "Bilibili 登录态",
        "description": "用于下载需要登录态的视频；视觉分析会复用同一配置，避免重复维护。",
        "allowedKinds": ["bilibili"],
        "defaultServiceId": "bilibili-default",
        "required": false
      }
    ],
    "fields": [
      {
        "id": "subtitleModel",
        "label": "默认字幕模型",
        "description": "内部分析没有显式传入 model 时使用。",
        "type": "select",
        "defaultValue": "base",
        "options": [
          { "value": "tiny", "label": "tiny" },
          { "value": "base", "label": "base" },
          { "value": "small", "label": "small" },
          { "value": "medium", "label": "medium" },
          { "value": "large", "label": "large" }
        ]
      }
    ]
  },
  "actions": [
    {
      "name": "read_skill",
      "description": "读取并应用该技能的说明与方法完成当前任务。",
      "runtime": "reference",
      "entry": "SKILL.md",
      "visibility": "internal",
      "params": []
    },
    {
      "name": "video_copy_analyze",
      "description": "运行视频字幕提取与 transcript 生成，供 RSS 视频分析等内部产品代码直接调用。",
      "runtime": "python",
      "entry": "scripts/ready_extract_subtitle.py",
      "visibility": "internal",
      "inputMode": "json",
      "params": [
        { "name": "input", "type": "string", "description": "视频 URL 或本地文件路径", "required": true },
        { "name": "outputDir", "type": "string", "description": "输出目录", "required": false },
        { "name": "model", "type": "string", "description": "whisper 模型", "required": false, "enum": ["tiny", "base", "small", "medium", "large"] },
        { "name": "language", "type": "string", "description": "语言 zh/en/auto", "required": false, "enum": ["zh", "en", "auto"] },
        { "name": "forceSubtitleMode", "type": "string", "description": "可选，强制字幕提取模式", "required": false, "enum": ["auto", "funasr"] }
      ]
    }
  ]
}
